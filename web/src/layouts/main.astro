---
// The one page shell: every page, including the generated views and sign-in, renders through this (DESIGN.md).
import "@/styles/global.css"
import { Menu } from "lucide-react"
import { HeaderMenu } from "@/components/HeaderMenu"
import SideNav from "@/components/SideNav.astro"

interface Props {
  title: string
  description?: string
  bare?: boolean // sign-in: no sidebar or top bar
}
const { title, description, bare = false } = Astro.props
const path = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · gg</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // before first paint, so there is no flash: the saved choices, else the OS setting and an open sidebar
      try {
        const t = localStorage.getItem("theme")
        document.documentElement.classList.toggle(
          "dark",
          t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches
        )
        if (localStorage.getItem("sidebar") === "collapsed") document.documentElement.dataset.sidebar = "collapsed"
      } catch {}
    </script>
  </head>
  <body class:list={["min-h-svh antialiased", bare ? "flex flex-col" : "md:flex"]}>
    <a
      href="#main"
      class="bg-card sr-only z-50 rounded-full px-4 py-2 text-sm font-medium shadow-panel focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    {
      !bare && (
        <>
          <aside
            id="sidebar"
            class="sidebar bg-card sticky top-0 z-40 hidden h-svh w-60 shrink-0 flex-col border-r transition-[width] duration-200 rail:w-18 md:flex"
          >
            <SideNav path={path} />
          </aside>
          <dialog
            id="nav-drawer"
            aria-label="Menu"
            class="bg-card text-foreground m-0 h-svh max-h-svh w-72 max-w-[85vw] border-r p-0 shadow-xl backdrop:bg-black/30 open:flex open:flex-col md:hidden"
          >
            <SideNav path={path} drawer />
          </dialog>
        </>
      )
    }
    <div class="flex min-w-0 flex-1 flex-col">
      {
        !bare && (
          <header class="bg-background/85 sticky top-0 z-30 backdrop-blur-md">
            <div class="mx-auto flex h-15 w-full max-w-7xl items-center gap-2 px-4 sm:px-5 lg:px-6">
              <button
                id="nav-open"
                type="button"
                aria-label="Open menu"
                aria-controls="nav-drawer"
                class="bg-card shadow-panel grid size-9 place-items-center rounded-full md:hidden"
              >
                <Menu className="size-[18px]" />
              </button>
              <a href="/" class="bg-brand text-brand-foreground grid size-8 place-items-center rounded-full font-mono text-xs font-bold md:hidden" aria-label="gg overview">
                gg
              </a>
              <HeaderMenu client:only="react" />
            </div>
          </header>
        )
      }
      <main
        id="main"
        class:list={[
          "mx-auto w-full max-w-7xl flex-1 px-4 sm:px-5 lg:px-6",
          bare ? "grid place-items-center py-10" : "pt-2 pb-12 sm:pt-4",
        ]}
      >
        {
          !bare && (
            <div class="mb-6 flex flex-wrap items-end justify-between gap-x-10 gap-y-5 sm:mb-8">
              <div class="max-w-2xl min-w-0 flex-[1_1_22rem]">
                <h1 class="text-[1.75rem] leading-tight font-semibold tracking-tight sm:text-[2rem]">{title}</h1>
                {description && (
                  <p class="text-muted-foreground mt-1.5 text-sm text-pretty">{description}</p>
                )}
              </div>
              {/* a page's KPI strip renders here from its React island (PageAside in common.tsx) */}
              <div id="page-aside" class="w-full empty:hidden sm:w-auto" />
            </div>
          )
        }
        <slot />
      </main>
    </div>
    <script>
      // the sidebar: collapse to an icon rail on desktop (remembered per browser); the menu drawer on phones
      const root = document.documentElement
      const toggle = document.getElementById("sidebar-toggle")
      const sync = () => {
        const label = root.dataset.sidebar === "collapsed" ? "Expand sidebar" : "Collapse sidebar"
        toggle?.setAttribute("aria-expanded", String(root.dataset.sidebar !== "collapsed"))
        toggle?.setAttribute("aria-label", label)
        toggle?.setAttribute("title", label)
      }
      sync()
      toggle?.addEventListener("click", () => {
        const collapse = root.dataset.sidebar !== "collapsed"
        if (collapse) root.dataset.sidebar = "collapsed"
        else delete root.dataset.sidebar
        try {
          if (collapse) localStorage.setItem("sidebar", "collapsed")
          else localStorage.removeItem("sidebar")
        } catch {}
        sync()
      })

      const drawer = document.getElementById("nav-drawer") as HTMLDialogElement | null
      document.getElementById("nav-open")?.addEventListener("click", () => drawer?.showModal())
      // a click on the backdrop lands on the dialog itself
      drawer?.addEventListener("click", (e) => {
        if (e.target === drawer || (e.target as Element).closest("[data-close]")) drawer.close()
      })
      matchMedia("(width >= 48rem)").addEventListener("change", (e) => e.matches && drawer?.close())
    </script>
  </body>
</html>
