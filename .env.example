# Copy to .env and fill in. Never commit .env or secrets/.

# The address people use. GitHub's login callback and webhook URLs are built from it.
# By IP (no domain): PUBLIC_URL=http://<vm-ip>:7000, leave DOMAIN empty, BIND_ADDR=0.0.0.0 (README 3.2.1).
PUBLIC_URL=https://portal.example.com
# With --profile https: the domain for the certificate, and BIND_ADDR=127.0.0.1 to keep 7000/7010 private.
DOMAIN=portal.example.com
BIND_ADDR=0.0.0.0

# MongoDB, the portal's database (README 1.12). Blank: the "mongo" service docker compose runs. MongoDB Atlas or
# another server: its connection string with the database name, e.g. mongodb+srv://user:pass@cluster/gg-docs
# (its own database, not GG-Ops's: the same cluster is fine, the same database is refused at start, and a database
# user with readWrite on gg-docs only is best). Upgrading from the SQLite release: README 6.1.
MONGODB_URI=
# People connect their own GG-Ops account (README 1.16): GG-Ops's address, and the client_id its POST /oauth/register
# returned for redirect URI PUBLIC_URL/connect/ggops/callback (https). Blank: only the workspace's GG-Ops key is used.
GGOPS_URL=
GGOPS_CLIENT_ID=
# Encrypts the GitHub tokens, LLM, Sonar and GG-Ops keys stored in MongoDB. Generate with: openssl rand -hex 32
# Back it up apart from the database: without it those secrets can't be read (people sign in again, admins re-enter
# keys). Blank: a key file is created in DATA_DIR on first start.
TOKEN_ENCRYPTION_KEY=

# The GitHub App (README 3.1): "Continue with GitHub" (callback URL: PUBLIC_URL/auth/callback), cloning the
# repositories people connect, their webhooks, and reviews posted on PRs. Installable by any account. The private
# key goes in secrets/github-app.pem.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Without the App, one operator's plain token (local development; nobody can sign in, use DEV_USER).
GITHUB_TOKEN=

# Team invites by email, through any SMTP provider. Port 587 uses STARTTLS, 465 TLS. Blank SMTP_HOST:
# nothing is emailed, and the inviter copies the invite link from Settings instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Upgrading a single-tenant install: `python -m portal.migrate` turns its data into one workspace named GITHUB_ORG,
# with these repositories, its architecture views and this (legacy) MCP token, owned by the GitHub logins in ADMINS
# (comma separated). Everyone else joins through an invite. Unused on a fresh install. Left commented out, they
# default to your-org, your-org/backend and your-org/frontend: set them before migrating.
# GITHUB_ORG=your-org
# BACKEND_REPO=your-org/backend
# FRONTEND_REPO=your-org/frontend
EXTRA_REPOS=
MCP_TOKEN=
ADMINS=

SONAR_DB_PASSWORD=
# The SonarQube link shown in the portal.
SONAR_PUBLIC_URL=https://portal.example.com/sonar

# How often to poll GitHub as a backup to webhooks, and how much history to load on first start.
POLL_SECONDS=300
BACKFILL_DAYS=90

# Optional services: https (Caddy) and llm (local model). install.sh sets this.
COMPOSE_PROFILES=https

# Default LLM for reviews and Ask (Settings overrides it). LOCAL_LLM=auto in install.sh fills these for the
# local model: LLM_KIND=openai, LLM_BASE_URL=http://llm:11434/v1, LLM_MODEL=qwen2.5-coder:...-instruct-q8_0.
LLM_KIND=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_EFFORT=
# Workspaces may only point their LLM base URL at public addresses (or the local model above). 1 allows private ones,
# for a server only one trusted team uses.
ALLOW_PRIVATE_LLM=
# The same for GG-Ops and gg-pulse addresses (Settings → Integrations), and for the LLM too.
ALLOW_PRIVATE_URLS=
LLM_TIMEOUT=
LLM_CONTEXT=16384
REVIEW_CHUNK_CHARS=
REVIEW_MAX_CHARS=
CHAT_TOOL_CHARS=
CHAT_TIMEOUT=
LLM_PARALLEL=
DOCS_CONTEXT_CHARS=

# ---- Less common. Left commented out on purpose: a blank line here would replace the default with "". ----

# Where the portal keeps clones, generated views and its key file. docker compose mounts a volume at /data.
# DATA_DIR=/data
# How long to wait for MongoDB before giving up at start, in milliseconds.
# MONGODB_TIMEOUT_MS=10000
# The GitHub App's private key inline, instead of secrets/github-app.pem (docker compose points
# GITHUB_APP_PRIVATE_KEY_FILE at that file). \n stands for a line break.
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# Branch to treat as default, per repository, when it isn't the one GitHub reports. JSON.
# DEFAULT_BRANCHES={"your-org/backend": "main"}
# Where to clone from; {repo} is owner/name and {name} the bare name. Local development can point at checkouts.
# GIT_URL_TEMPLATE=https://github.com/{repo}.git
# How the portal reaches SonarQube (docker compose sets it), and the token the scanner uses when an admin hasn't
# set one in Settings.
# SONAR_URL=http://localhost:7010
# SONAR_TOKEN=
# The local model's Ollama address (the compose "llm" service), and a host folder of already downloaded models to
# reuse instead of a fresh volume (install.sh finds one).
# OLLAMA_URL=http://llm:11434
# OLLAMA_DIR=/usr/share/ollama/.ollama
# The interpreter with the backend's requirements, for the OpenAPI export of the architecture views, and the
# graphify binary for the code graph. Default: the portal's own Python, and graphify on PATH.
# BACKEND_PYTHON=/usr/local/bin/python
# GRAPHIFY_BIN=graphify

# Local development only. DEV_USER signs in requests from this machine as that login when the GitHub App isn't set;
# DISABLE_WORKER=1 starts the web app without the background sync and review jobs.
# DEV_USER=devuser
# DISABLE_WORKER=1
