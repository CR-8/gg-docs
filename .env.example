# Copy to .env and fill in. Never commit .env or secrets/.

# The address people use. GitHub's login callback and webhook URLs are built from it.
PUBLIC_URL=https://portal.example.com
# With --profile https: the domain for the certificate, and keep 7000/7010 off the public interface.
DOMAIN=portal.example.com
BIND_ADDR=0.0.0.0

GITHUB_ORG=GeneGeniusinc
BACKEND_REPO=GeneGeniusinc/Genegenius-backend
FRONTEND_REPO=GeneGeniusinc/Genegenius-phase-1

# GitHub App (README: "Create the GitHub App"). The private key goes in secrets/github-app.pem.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# GitHub logins (comma separated) who can edit Settings: LLM keys, Sonar token, PR posting.
ADMINS=
# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

SONAR_DB_PASSWORD=
# The SonarQube link shown in the portal.
SONAR_PUBLIC_URL=https://portal.example.com/sonar

# How often to poll GitHub as a backup to webhooks, and how much history to load on first start.
POLL_SECONDS=300
BACKFILL_DAYS=90
