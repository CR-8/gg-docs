# Copy to .env and fill in. Never commit .env or secrets/.

# The address people use. GitHub's login callback and webhook URLs are built from it.
# By IP (no domain): PUBLIC_URL=http://<vm-ip>:7000, leave DOMAIN empty, BIND_ADDR=0.0.0.0 (README 3.2.1).
PUBLIC_URL=https://portal.example.com
# With --profile https: the domain for the certificate, and BIND_ADDR=127.0.0.1 to keep 7000/7010 private.
DOMAIN=portal.example.com
BIND_ADDR=0.0.0.0

GITHUB_ORG=GeneGeniusinc
BACKEND_REPO=GeneGeniusinc/Genegenius-backend
FRONTEND_REPO=GeneGeniusinc/Genegenius-phase-1

# Login without the GitHub App: the viewer password sees everything, the admin password can also change Settings.
PORTAL_PASSWORD=
ADMIN_PASSWORD=

# Read access to the two private repos (README "GitHub access"). A read-only token is enough;
# the GitHub App below is optional and replaces it when set.
GITHUB_TOKEN=

# GitHub App, optional (README 3.1): Sign in with GitHub, instant webhooks, reviews posted on PRs.
# The private key goes in secrets/github-app.pem.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# More repositories to sync, review and document (comma separated owner/name); admins can also add them in Settings.
EXTRA_REPOS=

# Secret for the MCP server (/mcp) that coding agents connect to. install.sh generates it; blank turns MCP off.
MCP_TOKEN=

# GitHub logins (comma separated) who can edit Settings: LLM keys, Sonar token, PR posting.
ADMINS=
# Signs login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

SONAR_DB_PASSWORD=
# The SonarQube link shown in the portal.
SONAR_PUBLIC_URL=https://portal.example.com/sonar

# How often to poll GitHub as a backup to webhooks, and how much history to load on first start.
POLL_SECONDS=300
BACKFILL_DAYS=90

# Optional services: https (Caddy) and llm (local model). install.sh sets this.
COMPOSE_PROFILES=https

# Default LLM for reviews and Ask (Settings overrides it). LOCAL_LLM=auto in install.sh fills these for the
# local model: LLM_KIND=openai, LLM_BASE_URL=http://llm:11434/v1, LLM_MODEL=qwen2.5-coder:...-instruct-q8_0.
LLM_KIND=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_EFFORT=
LLM_TIMEOUT=
LLM_CONTEXT=16384
REVIEW_CHUNK_CHARS=
REVIEW_MAX_CHARS=
CHAT_TOOL_CHARS=
CHAT_TIMEOUT=
LLM_PARALLEL=
DOCS_CONTEXT_CHARS=
